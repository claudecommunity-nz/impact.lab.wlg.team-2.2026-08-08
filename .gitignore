# macOS / editor noise
.DS_Store
**/.DS_Store
*.swp
*~

# Local dumps / scratch (never commit)
fixtures/
scripts/
**/fixtures/
vendor/

# Agent / internal notes if recreated locally
CLAUDE.md

# SwiftPM / Xcode local state
server/.build/
server/.swiftpm/
**/.build/
**/.swiftpm/
# Ignore Xcode projects by default, but track the SwiftUI app project
*.xcodeproj/
!swiftui/**/*.xcodeproj/
!swiftui/**/*.xcodeproj/**
*.xcworkspace/
!swiftui/**/*.xcworkspace/
!swiftui/**/*.xcworkspace/**
xcuserdata/
**/xcuserdata/
DerivedData/
**/DerivedData/

# Secrets / local env
.env
.env.*
.netrc
